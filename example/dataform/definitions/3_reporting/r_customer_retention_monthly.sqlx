config {
  type: "table",
  database: "folio-analytics-demo",
  schema: "reporting",
  description: "Customer cohorts by month of first order: how many customers of each cohort order again in later months.",
  tags: ["daily", "dp-sales-overview"],
  columns: {
    cohort_month: "Month of the first order of the customers in the row.",
    months_since_first_order: "Months between the cohort month and the order month, 0 for the cohort month.",
    active_customers: "Distinct customers of the cohort who ordered in that month.",
    retention_rate: "Active customers divided by the cohort size (active customers at offset 0)."
  }
}

WITH cohorts AS (
  SELECT
    cohort_month,
    DATE_DIFF(order_month, cohort_month, MONTH) AS months_since_first_order,
    COUNT(DISTINCT customer_id) AS active_customers
  FROM ${ref("customer_monthly_activity")}
  GROUP BY cohort_month, months_since_first_order
)

SELECT
  cohort_month,
  months_since_first_order,
  active_customers,
  SAFE_DIVIDE(
    active_customers,
    FIRST_VALUE(active_customers) OVER (PARTITION BY cohort_month ORDER BY months_since_first_order)
  ) AS retention_rate
FROM cohorts
